{
  "expo": {
    "name": "dermys",
    "slug": "dermys",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/dermys-v1/icone-home.png",
    "scheme": "dermys",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/brand/dermys-v1/icone-home.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#090909",
        "foregroundImage": "./assets/brand/dermys-v1/simbolo-amarelo.png",
        "monochromeImage": "./assets/brand/dermys-v1/simbolo-branco.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/dermys-v1/icone-home.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#090909",
          "image": "./assets/brand/dermys-v1/simbolo-amarelo.png",
          "imageWidth": 160
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
